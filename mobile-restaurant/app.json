{
  "expo": {
    "name": "Dima Hasao - Food Partner",
    "slug": "dima-hasao-restaurant",
    "scheme": "dimahasaorestaurant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.dimahsao.restaurant",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splashLogo.png",
          "imageWidth": 220,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Photos are used for menu items, your restaurant profile and documents.",
          "cameraPermission": "The camera is used to take photos of menu items, your restaurant and documents."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to set your restaurant address and delivery zone."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#B80B3D",
          "defaultChannel": "default"
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
