# Production build values — copy to `.env.production` on the deploy host.
#
# THIS FILE IS THE ONE THAT GETS FORGOTTEN. `.env.*` is gitignored, so a fresh
# `git clone` on a server has NO `.env.production`. Vite loads plain `.env` in
# every mode, so a build without this file silently picks up the localhost
# values from `.env` and the deployed site calls http://localhost:5000 from the
# visitor's own browser — "Network Error" on every request.
#
# Vite inlines VITE_* at BUILD time. Editing any env file after `npm run build`
# changes nothing: rebuild and redeploy dist/ after every change here.
#
# Values here override `.env`; anything not listed falls through to `.env`,
# so this file only needs the keys that differ in production.

# ── API ──────────────────────────────────────────────────────────────────────
# Relative, so the API is whatever origin serves the app and nginx forwards
# /api to the backend on 127.0.0.1:5000. Set an absolute origin only when the
# API lives on a different host — and then SOCKET_CORS_ORIGIN/FRONTEND_URL in
# Backend/.env must name this site.
VITE_API_BASE_URL=/api/v1

# Socket.IO runs on its own port (5001) behind the proxy. Leave blank when
# nginx forwards /socket.io on the main origin; set the full origin only when
# the realtime server is exposed separately, e.g. https://ws.example.com.
VITE_SOCKET_URL=
# Only used to derive a socket port from an ABSOLUTE API base (dev). Ignored
# when VITE_API_BASE_URL is relative.
VITE_SOCKET_PORT=5001

# Origin serving /uploads images. Blank = same origin as the page, which is
# what the nginx `location /uploads/` block above serves.
VITE_ASSET_BASE_URL=

# ── Test bypasses — MUST be off in production ────────────────────────────────
# Leaving this true ships the shared OTP test phone to real users.
VITE_USE_DEFAULT_TEST_PHONE=false
VITE_DEFAULT_TEST_PHONE=

# ── Third party ──────────────────────────────────────────────────────────────
# These usually match `.env`; restate them only if the prod project differs.
# Note: no stray quotes — a trailing `"` ends up inside the inlined string.
VITE_GOOGLE_MAPS_API_KEY=
VITE_ENABLE_MAP_SIMULATION=false

# Live key, not rzp_test_*.
VITE_RAZORPAY_KEY_ID=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_VAPID_KEY=
