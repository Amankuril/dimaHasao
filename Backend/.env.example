
# ─── Hotel module (ported from HomeZoo) ──────────────────────────────────────
# Cloudinary backs property/room image uploads. Without these, hotel image
# upload fails — the rest of the hotel module still works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Extra mail options the hotel mailer uses (it shares EMAIL_HOST/PORT/USER/PASS
# with the rest of the platform).
EMAIL_SECURE=false
EMAIL_FROM_NAME=Dima Hasao

# Only needed for Razorpay payouts to hotel partners.
RAZORPAY_ACCOUNT_NUMBER=

# Encrypts admin-editable Maps/Razorpay keys stored in the database (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=
