# Live HTTPS API (required for production EAS builds; no localhost/http)
EXPO_PUBLIC_API_URL=https://your-domain.example/api/v1
EXPO_PUBLIC_SOCKET_URL=https://your-domain.example
# Google Maps key for the NATIVE map only (restrict it to this app: package name + SHA-1).
# Geocoding, routes and places go through the backend, which holds its own key (changeable from the admin panel).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase (web config)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app/


# Optional dev toggles
EXPO_PUBLIC_APP_MODE=
EXPO_PUBLIC_USE_DEFAULT_TEST_PHONE=false
EXPO_PUBLIC_DEFAULT_TEST_PHONE=
EXPO_PUBLIC_ENABLE_RANGE_BYPASS=false
