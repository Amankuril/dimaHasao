# Live HTTPS API (required for production EAS builds; no localhost/http)
EXPO_PUBLIC_API_URL=https://your-domain.example/api/v1
EXPO_PUBLIC_SOCKET_URL=https://your-domain.example
# Google Maps key for the NATIVE map only (restrict it to this app: package name + SHA-1).
# Geocoding, routes and places go through the backend, which holds its own key (changeable from the admin panel).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app/
