# Copy to `.env` (gitignored) and fill in real values before building.
# react-native-config reads this at Gradle build time — unlike the web app,
# a mobile build has no "same origin" to fall back to, so API_BASE_URL must
# be an absolute URL to the deployed backend (or your machine's LAN IP when
# running against a local backend from a physical device/emulator).

# e.g. https://api.dimahasao.example.com/api/v1
API_BASE_URL=

# Socket.IO server origin (blank = derive from API_BASE_URL's host).
SOCKET_URL=

GOOGLE_MAPS_API_KEY=

# Live key, not rzp_test_*, for production builds.
RAZORPAY_KEY_ID=

FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
